soong_namespace {}

cc_library_headers {
    name: "libsvepsr_rk3588_headers",
    vendor: true,
    export_include_dirs: ["lib/Android/rk3588/include"],
}

cc_prebuilt_library_shared {
    name: "libsvepsr",
    vendor: true,
    compile_multilib: "first",
    srcs: ["lib/Android/rk3588/arm64-v8a/libsvepsr.so"],
    check_elf_files: false,
    strip: {
        none: true,
    },
    required: ["SrOsd.ttf"],
}

prebuilt_etc {
    name: "SrOsd.ttf",
    vendor: true,
    src: "resources/osd/SrOsd.ttf",
    filename_from_src: true,
}
